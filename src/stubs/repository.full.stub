<?php

namespace {{ namespace }};

use Folklore\Repositories\Entities;
use {{ namespacedModel }} as {{ modelAlias }};
use {{ namespacedContract }} as {{ contractAlias }};
use {{ namespacedEntity }} as {{ entityAlias }};

class {{ class }} extends Entities implements {{ contractAlias }}
{
    protected function newModel(): {{ modelAlias }}
    {
        return new {{ modelAlias }}();
    }

    protected function newQuery()
    {
        return parent::newQuery();
    }

    public function findById(string $id): ?{{ entityAlias }}
