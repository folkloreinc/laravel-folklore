<?php

namespace {{ namespace }};

use Folklore\Repositories\Entities;
use {{ namespacedModel }} as {{ modelAlias }};
use {{ namespacedContract }} as {{ contractAlias }};
use {{ namespacedEntity }} as {{ entityAlias }};

/**
 * @extends Entities<{{ modelAlias }}, {{ entityAlias }}>
 */
class {{ class }} extends Entities implements {{ contractAlias }}
{
    protected function newModel(): {{ modelAlias }}
    {
        return new {{ modelAlias }}();
    }

    public function findById(string $id): ?{{ entityAlias }}
    {
        $entity = parent::findById($id);

        return $entity instanceof {{ entityAlias }} ? $entity : null;
    }

    public function create($data): {{ entityAlias }}
    {
        $entity = parent::create($data);
        if (! $entity instanceof {{ entityAlias }}) {
            throw new \LogicException({{ modelAlias }}::class.'::toEntity() must return a '.{{ entityAlias }}::class.'.');
        }

        return $entity;
    }

    public function update(string $id, $data): ?{{ entityAlias }}
    {
        $entity = parent::update($id, $data);

        return $entity instanceof {{ entityAlias }} ? $entity : null;
    }
}
