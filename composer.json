{
    "name": "folklore/laravel-folklore",
    "description": "",
    "keywords": [
        "laravel"
    ],
    "homepage": "http://github.com/Folkloreatelier",
    "license": "MIT",
    "authors": [
        {
            "name": "Folklore",
            "email": "info@folklore.email",
            "homepage": "http://folkloreinc.ca"
        },
        {
            "name": "David Mongeau-Petitpas",
            "email": "dmp@folklore.email",
            "homepage": "http://mongo.ca",
            "role": "Developer"
        },
        {
            "name": "Nicolas Roy-Bourdages",
            "email": "nrb@folklore.email",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "folklore/laravel-panneau": "v1.2.x-dev|v1.3.x-dev|v1.4.x-dev",
        "folklore/laravel-mediatheque": "^1.1",
        "folklore/laravel-image": "^1.1",
        "folklore/laravel-locale": "v8.x-dev",
        "cviebrock/eloquent-sluggable": "^11.0|^12.0|^13.0",
        "google/apiclient": "^2.18",
        "guzzlehttp/guzzle": "^7.15.2",
        "laravel/fortify": "^1.13",
        "parsecsv/php-parsecsv": "^1.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-0": {
            "Folklore": "src/"
        },
        "files": [
            "src/Folklore/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Folklore\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=2G"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Folklore\\ServiceProvider"
            ]
        }
    },
    "suggest": {
        "pubnub/pubnub": "Allows broadcasting events via pubnub."
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
